{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omoniyi-ipaye/system-design-architect/model/system.schema.json",
  "title": "System Design Architect Canonical System Model",
  "type": "object",
  "required": ["schema_version", "system", "elements", "flows"],
  "properties": {
    "schema_version": {"type": "string"},
    "system": {
      "type": "object",
      "required": ["id", "name", "purpose", "stage"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "purpose": {"type": "string"},
        "stage": {"enum": ["as_is", "transition", "target", "mixed"]},
        "domain": {"type": "string"},
        "desired_outcomes": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "non_goals": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"$ref": "#/$defs/claim"}}
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "stage": {"$ref": "#/$defs/stage"},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      },
      "default": []
    },
    "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}},
    "flows": {"type": "array", "items": {"$ref": "#/$defs/flow"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}, "default": []},
    "risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}, "default": []},
    "capacity": {"type": "array", "items": {"$ref": "#/$defs/capacity"}, "default": []},
    "fitness_checks": {"type": "array", "items": {"$ref": "#/$defs/fitness"}, "default": []},
    "health_signals": {"type": "array", "items": {"$ref": "#/$defs/signal"}, "default": []},
    "recovery_actions": {"type": "array", "items": {"$ref": "#/$defs/recovery"}, "default": []},
    "adaptation": {
      "type": "object",
      "properties": {
        "level": {"enum": ["L0", "L1", "L2", "L3"]},
        "allowed": {"type": "array", "items": {"type": "string"}},
        "requires_governed_redesign": {"type": "array", "items": {"type": "string"}},
        "max_blast_radius": {"type": "string"}
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "change"],
        "properties": {
          "id": {"type": "string"},
          "from": {"enum": ["as_is", "transition", "target"]},
          "to": {"enum": ["as_is", "transition", "target"]},
          "change": {"type": "string"},
          "verification": {"type": "string"},
          "rollback": {"type": "string"}
        }
      },
      "default": []
    }
  },
  "$defs": {
    "stage": {"enum": ["as_is", "transition", "target", "shared"]},
    "evidence": {"enum": ["observed", "assumed", "proposed", "unknown"]},
    "claim": {
      "type": "object",
      "required": ["text", "evidence"],
      "properties": {
        "text": {"type": "string"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "source": {"type": "string"}
      }
    },
    "element": {
      "type": "object",
      "required": ["id", "name", "kind", "stage", "evidence"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "kind": {"enum": ["actor", "capability", "process", "service", "system", "decision", "state", "resource", "queue", "control", "metric", "external", "device", "data_store"]},
        "stage": {"$ref": "#/$defs/stage"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "description": {"type": "string"},
        "owner": {"type": "string"},
        "boundary": {"type": "string"},
        "source": {"type": "string"}
      }
    },
    "flow": {
      "type": "object",
      "required": ["id", "from", "to", "type", "stage", "evidence"],
      "properties": {
        "id": {"type": "string"},
        "from": {"type": "string"},
        "to": {"type": "string"},
        "type": {"enum": ["work", "information", "authority", "state", "money", "material", "resource", "feedback", "dependency"]},
        "label": {"type": "string"},
        "stage": {"$ref": "#/$defs/stage"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "handoff_contract": {
          "type": "object",
          "properties": {
            "required_input": {"type": "string"},
            "owner": {"type": "string"},
            "acknowledgement": {"type": "string"},
            "timing": {"type": "string"},
            "failure_behavior": {"type": "string"},
            "escalation": {"type": "string"}
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "required": ["id", "name", "owner", "stage", "evidence"],
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"}, "owner": {"type": "string"},
        "rule": {"type": "string"}, "reversible": {"type": "boolean"},
        "stage": {"$ref": "#/$defs/stage"}, "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "risk": {
      "type": "object",
      "required": ["id", "name", "severity", "stage"],
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"},
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "stage": {"$ref": "#/$defs/stage"}, "affects": {"type": "array", "items": {"type": "string"}},
        "cause": {"type": "string"}, "control": {"type": "string"}, "recovery": {"type": "string"}
      }
    },
    "capacity": {
      "type": "object",
      "required": ["id", "name", "stage"],
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"}, "stage": {"$ref": "#/$defs/stage"},
        "arrival_rate": {"type": ["number", "null"]}, "processing_rate": {"type": ["number", "null"]},
        "unit": {"type": "string"}, "queue": {"type": "string"}, "notes": {"type": "string"}
      }
    },
    "fitness": {
      "type": "object",
      "required": ["id", "requirement", "mechanism", "verification", "pass_condition"],
      "properties": {
        "id": {"type": "string"}, "requirement": {"type": "string"}, "mechanism": {"type": "string"},
        "verification": {"type": "string"}, "pass_condition": {"type": "string"}, "validation": {"type": "string"}
      }
    },
    "signal": {
      "type": "object",
      "required": ["id", "name", "desired_state"],
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"}, "desired_state": {"type": "string"},
        "source": {"type": "string"}, "threshold": {"type": "string"}, "owner": {"type": "string"}
      }
    },
    "recovery": {
      "type": "object",
      "required": ["id", "trigger", "action", "authority", "level"],
      "properties": {
        "id": {"type": "string"}, "trigger": {"type": "string"}, "action": {"type": "string"},
        "authority": {"type": "string"}, "level": {"enum": ["L0", "L1", "L2", "L3"]},
        "reversible": {"type": "boolean"}, "verification": {"type": "string"}, "escalation": {"type": "string"}
      }
    }
  }
}