{
  "name": "system-design-architect-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:widget": "esbuild web/src/component.tsx --bundle --format=esm --jsx=automatic --outfile=web/dist/component.js",
    "build": "npm run build:widget && tsc -p server/tsconfig.json",
    "check": "tsc -p server/tsconfig.json --noEmit",
    "start": "npm run build:widget && tsx server/src/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}